# Path inside the server/container to a compatible GGUF instruction model
SHOHIN_MODEL_PATH=/models/qwen3-0.6b-q4_k_m.gguf
SHOHIN_N_CTX=4096
SHOHIN_THREADS=4
SHOHIN_MAX_TOKENS=384

# Basic per-IP limit; for a public multi-instance service use Redis/shared rate limiting
SHOHIN_RATE_PER_MINUTE=12

# Set exact app origins before public deployment; "*" is for local testing only
SHOHIN_ALLOWED_ORIGINS=*
